{
  "rules": {
    "sessions": {
      "$code": {
        ".read": true,
        ".write": true,
        "votes": {
          "$matric": {
            ".write": true,
            ".validate": "newData.hasChildren(['vote', 'name', 'matric', 'at']) && newData.child('vote').isString() && newData.child('matric').isString() && newData.child('name').isString()"
          }
        }
      }
    }
  }
}
